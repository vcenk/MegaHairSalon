# ─── Core site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://megashairsalon.ca

# ─── Booking (Phorest) ─────────────────────────────────────────
# Hosted booking page (services + pricing live here). Set in lib/constants.ts
# (BOOKING.url); this env var is only needed if the booking URL is made
# environment-specific later.
# NEXT_PUBLIC_BOOKING_URL=https://phorest.com/book/salons/megashairsalon

# ─── Transactional email (Resend) ──────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
CONTACT_FORM_TO_EMAIL=hello@megashairsalon.ca

# ─── Analytics ─────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-REPLACE_ME
NEXT_PUBLIC_CLARITY_ID=REPLACE_ME

